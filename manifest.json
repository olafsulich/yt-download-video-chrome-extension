{
  "manifest_version": 3,
  "name": "YouTube Video Downloader",
  "short_name": "YT Video",
  "version": "1.0.0",
  "description": "Adds a one-click button to the YouTube watch page that downloads the video in the best available quality.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
